# Environment Variables for Commissions Bot
# Copy this to .env and fill in your values

DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_bot_client_id
GUILD_ID=your_server_id
ORDER_CATEGORY_ID=category_id_for_orders
TICKET_LOG_CHANNEL_ID=channel_id_for_logs
REVIEW_CHANNEL_ID=channel_id_for_reviews
ORDER_CHANNEL_PREFIX=order-
STAFF_ROLE_ID=role_id_for_staff
SUPPORT_ROLE_ID=role_id_for_support
PREFIX=!